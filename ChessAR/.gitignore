# =======================
# Unity .gitignore (Recommended)
# =======================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get huge
[Mm]emoryCaptures/

# Recordings (Unity Recorder)
[Rr]ecordings/

# JetBrains Rider / IntelliJ
.idea/
*.sln.iml

# Visual Studio / VS Code
.vs/
.vscode/
*.csproj
*.sln
*.unityproj
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta / cache
sysinfo.txt

# Crash reports
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# StreamingAssets (keep if you use it)
# If you want to ignore only large files inside it, uncomment and customize
# [Ss]treaming[Aa]ssets/

# Addressables cache
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Gradle / Android
.gradle/
*.gradle

# IL2CPP
.il2cpp/

# Autogenerated by Unity
*.stackdump

# =======================
# Optional: Keep only project settings & assets
# =======================
# Unity keeps a lot in Assets/ + Packages/ + ProjectSettings/
# So generally you DO want to track:
# - Assets/
# - Packages/
# - ProjectSettings/
